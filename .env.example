# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=generate_a_64_char_hex_key_here
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:8000

# ── LLM (Google Gemini) ───────────────────────────────────────────────────────
# Get from: https://aistudio.google.com → Get API Key
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
GEMINI_FREE_TIER_DAILY_LIMIT=1500

# ── Google Calendar OAuth 2.0 ─────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_CALENDAR_DAILY_LIMIT=1000000

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# e.g., mongodb+srv://username:password@cluster.mongodb.net/calender_agent?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/calender_agent?retryWrites=true&w=majority
MONGODB_DB_NAME=calender_agent

# ── Security & Token Encryption ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_base64_fernet_key_here

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── Admin Access ──────────────────────────────────────────────────────────────
ADMIN_EMAILS=omichandra536@gmail.com
LANGCHAIN_TRACING_V2=false
